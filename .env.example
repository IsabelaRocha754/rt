# Copy to .env and fill in real values locally. Never commit .env.
# See docs/TRD.md §10 for the full var list and docs/SECURITY.md for handling rules.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Required in Phase 0 ---
DATABASE_URL=postgres://app_user:changeme@localhost:5432/plate
DATABASE_URL_OWNER=postgres://app_owner:changeme@localhost:5432/plate
ADMIN_ORIGIN=http://localhost:5173

# --- Required in Phase 1 (Better Auth: email+password, Google, Apple) ---
# Generate a real secret locally, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-32-byte-random-value
BETTER_AUTH_URL=http://localhost:3000
# EMAIL_API_KEY empty = sendVerificationEmail/sendResetPassword log to
# stdout instead of sending mail (fine locally; required in production).
EMAIL_API_KEY=
EMAIL_FROM=Plate <no-reply@plate.app>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Added in later phases (optional for now; schema tightens as each phase lands) ---
GOOGLE_PLACES_API_KEY=
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_QUARANTINE=plate-quarantine
S3_BUCKET_PUBLIC=plate-public
S3_BUCKET_PRIVATE=plate-private
FIELD_ENCRYPTION_KEY=replace-with-32-byte-random-value
SENTRY_DSN=

# --- Mobile (app.config.ts reads these — no secrets, no DB credentials) ---
API_URL=http://localhost:3000
APP_NAME=Plate
